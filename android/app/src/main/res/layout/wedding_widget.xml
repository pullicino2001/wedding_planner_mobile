<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFAF7F5"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="The Big M"
            android:textSize="13sp"
            android:textColor="#5E3A52"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timeline"
            android:textSize="10sp"
            android:textColor="#9E8A97"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0E8ED"
        android:layout_marginBottom="8dp" />

    <!-- Task 0 -->
    <LinearLayout
        android:id="@+id/task_0_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/task_0_date"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#C07A92"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:background="#E8D5DE"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/task_0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#3A2D36"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_0_assignee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="#9E8A97"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Task 1 -->
    <LinearLayout
        android:id="@+id/task_1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/task_1_date"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#C07A92"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:background="#E8D5DE"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/task_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#3A2D36"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_1_assignee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="#9E8A97"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Task 2 -->
    <LinearLayout
        android:id="@+id/task_2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/task_2_date"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#C07A92"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:background="#E8D5DE"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/task_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#3A2D36"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_2_assignee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="#9E8A97"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No upcoming tasks"
        android:textSize="12sp"
        android:textColor="#9E8A97"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
